# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (Default: 5000 for standalone, 3000 in container)
PORT=5000

# Demo Mode: Runs recommendation engine, market data, and weather without external APIs (set 'false' for live APIs)
DEMO_MODE=true

# MongoDB URI connection string (optional - runs in-memory if unconfigured)
MONGODB_URI=

# JWT Secret for authorization tokens
JWT_SECRET=

# OpenWeatherMap API key (optional - uses Open-Meteo free API or demo data if empty)
OPENWEATHER_API_KEY=

# Live Mandi / APMC Market API Key (optional - uses realistic simulated benchmarks if empty)
MARKET_API_KEY=

# Frontend API URL (leave empty for same-origin proxying)
VITE_API_URL=
